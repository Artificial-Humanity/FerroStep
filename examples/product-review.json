{
  "name": "product-review",
  "purpose": "docs/north-star.md@main",
  "roles": ["product_reviewer", { "name": "owner", "human": true }],
  "states": ["queued", "reviewing", "delivered", "acknowledged", "stalled"],
  "initial": "queued",
  "terminal": ["acknowledged"],
  "halted": ["stalled"],
  "counters": [
    { "name": "review_attempts", "max": 2, "on_exhausted": "stalled" },
    { "name": "reviews_queued", "max": 4, "on_exhausted": "stalled" }
  ],
  "creation": {
    "roles": ["owner"],
    "spends": ["reviews_queued"],
    "requires_note": true
  },
  "rescopes": [
    { "label": "release_line", "role": "owner", "requires_note": true }
  ],
  "grades": [
    { "attribute": "confidence", "ladder": ["low", "medium", "high"],
      "raise": ["owner"], "lower": ["product_reviewer"], "requires_note": true }
  ],
  "transitions": [
    { "from": "queued", "to": "reviewing", "role": "product_reviewer", "spends": ["review_attempts"] },
    { "from": "reviewing", "to": "delivered", "role": "product_reviewer" },
    { "from": "reviewing", "to": "queued", "role": "owner" },
    { "from": "delivered", "to": "acknowledged", "role": "owner" },
    { "from": "stalled", "to": "queued", "role": "owner", "resets": ["review_attempts"] }
  ]
}
